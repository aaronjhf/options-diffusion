# Cached proprietary data — never commit
cache/
*.parquet
*.npy
.env

# Experiment outputs
checkpoints/
runs/
*.png
!docs/*.png

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# Editors
.vscode/
.idea/
.ipynb_checkpoints/

# OS
.DS_Store

# Cache symlink (points outside repo)
cache

# Track committed experiment results: override the *.parquet / *.png / *.npy
# ignores above for the results/ tree only. cache/ stays ignored (a file under
# an ignored directory cannot be re-included), so proprietary data is unaffected.
!results/**/*.parquet
!results/**/*.png
!results/**/*.npy
